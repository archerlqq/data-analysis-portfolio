# 工作记录目录（本地分析过程，不进仓库）
.workbuddy/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# 本地环境变量文件（存放数据库口令等）
.env
.env.local

# 数据中间产物（体积大，可由脚本重新生成，不入库）
bilibili_food_analysis/*_cleaned.csv
bilibili_food_analysis/*_features.csv

# 临时文件
~$*.xlsx
~$*.docx
